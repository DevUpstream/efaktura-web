{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "paths": {
      "decimal.js": [
        "./node_modules/decimal.js"
      ],
      "@calc": [
        "../api/src/domain/calc.ts"
      ]
    }
  },
  "include": [
    "src",
    "../api/src/domain/calc.ts"
  ]
}